generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Anime {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  rating      String?   @default("N/A")
  type        String?   @default("TV")
  episodes    Episode[]
  createdAt   DateTime  @default(now())
}

model Episode {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  animeId       String          @db.ObjectId
  anime         Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodeNumber Int
  title         String?
  sources       EpisodeSource[]
}

model EpisodeSource {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  episodeId   String   @db.ObjectId
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider    String   // "TERABOX" or "GDRIVE"
  language    String   // "SUB" or "DUB"
  sourceUrl   String   @unique
  status      String   @default("PENDING") // PENDING, READY, DEAD
  resolvedUrl String?  // The direct MP4 link generated by backend
  createdAt   DateTime @default(now())
}
model TranscodingJob {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  episodeSourceId String         @db.ObjectId
  episodeSource   EpisodeSource @relation(fields: [episodeSourceId], references: [id])
  status          String         @default("QUEUED")
  progress        Float          @default(0)
  logs            String?       
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}